DB_HOST=localhost
DB_PORT=5432
DB_NAME=baolam_website
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
AUTH_SECRET=replace-with-at-least-32-random-characters
# Stable across deployments; generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
GCS_BUCKET_NAME=baolam-website-media
# Paste the complete service-account key JSON as one secret environment variable.
GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...","client_email":"..."}
SITE_URL=https://noithatbaolam.com
# Comma-separated additional HTTPS image hosts, if a custom media CDN is used.
MEDIA_ALLOWED_HOSTS=
# Get an API key at https://resend.com — used to email a notification whenever
# a contact request (quick or project brief) is submitted.
RESEND_API_KEY=
# Inbox that receives the notification email.
CONTACT_NOTIFICATION_EMAIL=
# Must be onboarding@resend.dev until a sending domain is verified with Resend,
# after which switch to an address on that domain (e.g. notifications@noithatbaolam.com).
CONTACT_NOTIFICATION_FROM=onboarding@resend.dev
